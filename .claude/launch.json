{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "figextract",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8010
    },
    {
      "name": "figextract-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx vite --port \"${PORT:-8012}\""
      ],
      "port": 8012,
      "autoPort": true
    },
    {
      "name": "openrouter-proxy",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/openrouter-proxy.mjs"
      ],
      "port": 8787
    },
    {
      "name": "figextract-build",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run -s build && exec npx vite preview --port 8014"
      ],
      "port": 8014
    }
  ]
}
